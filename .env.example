# Jobberman x Mastercard Foundation Mentorship Portal - Environment Template

# Live Backend REST / GraphQL API Endpoint
VITE_API_BASE_URL=https://api-mentorship.jobberman.com/v1

# Data Mode Switcher (true = LocalStorage mock data demo, false = Live API fetch calls)
VITE_ENABLE_MOCK_DATA=false

# External Integration Endpoints
VITE_ZOHO_MEET_API_URL=https://meeting.zoho.com/api/v1

# Application Title & Metadata
VITE_APP_TITLE="Jobberman x Mastercard Foundation Mentorship Portal"
